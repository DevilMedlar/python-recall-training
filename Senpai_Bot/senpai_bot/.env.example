# Required: exact name shown by `ollama list`
OLLAMA_MODEL=llama3.1

# Optional Ollama connection settings
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=120

# `compact` keeps local chat responsive and loads repository files on demand.
# `full` injects README.md, rules.md, SECURITY.md, and overall_grades.md into
# every fresh system prompt and needs a model/context window large enough for it.
OLLAMA_CONTEXT_MODE=compact

# Optional. Increase only if the selected model and available RAM/VRAM support it.
# OLLAMA_NUM_CTX=65536

# Number of persisted non-system messages retained in the prompt.
OLLAMA_MAX_HISTORY_MESSAGES=24
